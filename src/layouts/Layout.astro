---
import '@fontsource-variable/onest';
import { ViewTransitions } from 'astro:transitions';
import Footer from '../components/Footer.astro';
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Portafolio de Anderson Marín: proyectos, experiencia y contacto."
    />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ViewTransitions />
  </head>
  <body
    class="relative flex min-h-screen flex-col bg-gradient-to-b from-white via-neutral-50 to-white text-neutral-900 transition-colors duration-300 dark:from-neutral-950 dark:via-neutral-900 dark:to-neutral-950 dark:text-neutral-50"
  >
    <slot />
    <Footer />
  </body>
</html>
<style is:global>
  :root {
    color-scheme: light dark;
  }
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap');
  html {
    font-family:
      'Space Grotesk',
      'Inter Variable',
      'Onest Variable',
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      sans-serif;
    scroll-behavior: smooth;
    letter-spacing: -0.01em;
    scroll-snap-type: y mandatory;
  }
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  @media (max-width: 480px) {
    body {
      font-size: 15px;
    }
    h1 {
      font-size: 1.9rem;
      line-height: 1.15;
    }
    h2 {
      font-size: 1.55rem;
      line-height: 1.2;
    }
    h3 {
      font-size: 1.35rem;
      line-height: 1.25;
    }
    p, li {
      line-height: 1.5;
    }
  }
</style>
