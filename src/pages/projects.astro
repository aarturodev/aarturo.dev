---

import {PROJECTS, type Project} from "../data/projects";
import SectionContainer from "../components/SectionContainer.astro";
import CardProject from "../components/CardProject.astro";

import Layout from "../layouts/Layout.astro";

---

<Layout title="Anderson Marin - Proyectos">
  <main class="relative flex min-h-screen flex-col py-4 md:py-6">
    <SectionContainer>
      <section>
        <h3 class="text-xl py-4 font-medium">Todos los proyectos</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {
            PROJECTS.map((project:Project) => (
              <CardProject project={project} />
            ))
          }
        </div>
      </section>
    </SectionContainer>
  </main>
</Layout>