---
import CardCourses from '../components/CardCourses.astro';
import SectionContainer from '../components/SectionContainer.astro';
import { COURSES, type Course } from '../data/courses';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Anderson Marin - Cursos">
  <main class="relative flex min-h-screen flex-col py-6 md:py-10">
    <SectionContainer>
      <section class="min-h-screen flex flex-col rounded-2xl p-6 mx-auto w-full max-w-5xl">
        <div class="mb-4 flex items-center justify-between">
          <h3 class="text-2xl font-semibold text-neutral-900">
            Todos los cursos
          </h3>
          <a
            href="/"
            class="inline-flex items-center gap-2 rounded-full border border-neutral-200 px-4 py-2 text-sm font-semibold text-neutral-700 transition hover:-translate-y-[1px] hover:border-neutral-300 hover:text-neutral-900"
          >
            ← Volver
          </a>
        </div>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
          {COURSES.map((course: Course) => <CardCourses {...course} showDetails={false} />)}
        </div>
      </section>
    </SectionContainer>
  </main>
</Layout>
