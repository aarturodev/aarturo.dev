---

import {PROJECTS, type Project} from "../data/projects";
import {COURSES, type Course }from "../data/courses";
import SectionContainer from "../components/SectionContainer.astro";
import CardProject from "../components/CardProject.astro";

import Layout from "../layouts/Layout.astro";
import CardCourses from "../components/CardCourses.astro";
import type { Code } from "astro:components";

---

<Layout title="Anderson Marin - Cursos">
  <main class="relative flex min-h-screen flex-col py-6 md:py-10">

    <SectionContainer>
      <section >
        <h3 class="text-2xl font-semibold text-neutral-800 dark:text-neutral-100 mb-4">Todos los cursos</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {
            COURSES.map((course: Course) => (
              <CardCourses {...course} />
            ))
          }
        </div>
      </section>
    </SectionContainer>

  </main>
</Layout>
