---
import { COURSES, type Course } from '../data/courses';
import CardCourses from './CardCourses.astro';
import Arrow from './icons/Arrow.astro';
---

<section>
  <div class="flex justify-between py-4">
    <h2 class="text-xl p-2 font-medium">Cursos</h2>
    <a
      title="Más cursos"
      aria-label="More courses"
      class="flex items-center gap-1 -translate-x-3 hover:scale-105 ease-in-out duration-300 text-neutral-500"
      href="/courses"
    >
      <span class="text-sm underline underline-offset-4"> Ver más cursos</span>
      <!--<Arrow class="size-5 rotate-45" /> -->
    </a>
    <!-- -->
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    {COURSES.slice(0, 2).map((course: Course) => <CardCourses {...course} />)}
  </div>
</section>
