---
import { COURSES, type Course } from '../data/courses';
import CardCourses from './CardCourses.astro';
---

<section
  id="cursos"
  class="w-full px-4 min-h-screen flex items-center justify-center snap-start"
>
  <div class="mx-auto flex w-full max-w-5xl flex-col gap-5 rounded-2xl p-6">
    <div
      class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between pb-3"
    >
      <div>
        <p
          class="text-xs font-semibold uppercase tracking-[0.18em] text-neutral-400"
        >
          Aprendizaje
        </p>
        <h2 class="text-4xl font-semibold tracking-tight text-neutral-900">
          Cursos y certificaciones
        </h2>
      </div>
      <a
        title="Más cursos"
        aria-label="More courses"
        class="inline-flex items-center gap-2 self-start rounded-full border border-neutral-200 px-4 py-2 text-sm font-semibold text-neutral-700 transition hover:-translate-y-[1px] hover:border-neutral-300 hover:text-neutral-900"
        href="/courses"
      >
        Ver todos
      </a>
    </div>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      {
        COURSES.slice(0, 4).map((course: Course, idx: number) => (
          <div class={idx >= 2 ? 'hidden sm:block' : ''}>
            <CardCourses {...course} showDetails={false} />
          </div>
        ))
      }
    </div>
  </div>
</section>
