---
import type { Project } from '../data/projects';
import GitHub from './icons/GitHub.astro';
import Lock from './icons/Lock.astro';

type Props = {
  project: Project;
};

const { logo, title, description, tags, link, gitHub, visibility } =
  Astro.props.project;
---

<article
  class="flex h-full flex-col gap-3 rounded-xl border border-neutral-200 bg-white p-4 transition hover:-translate-y-[1px] dark:border-neutral-800 dark:bg-neutral-900"
>
  <header class="flex items-center justify-between">
    <div class="flex items-center gap-3">
      <div>
        <a
          href={link}
          target="_blank"
          rel="noopener noreferrer"
          class="text-base font-semibold text-neutral-900 transition hover:text-neutral-700 dark:text-neutral-100 dark:hover:text-neutral-200"
          aria-label={title}
        >
          {title}
        </a>
        <p class="text-xs text-neutral-500 dark:text-neutral-400">
          {visibility === 'private' ? 'Privado' : 'Público'}
        </p>
      </div>
    </div>
    {
      gitHub && (
        <a
          href={gitHub}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          title="Repositorio de GitHub"
          class="rounded-md p-2 text-neutral-500 transition hover:bg-neutral-100 hover:text-neutral-800 dark:hover:bg-neutral-800"
        >
          {visibility === 'private' ? (
            <Lock class="size-4" />
          ) : (
            <GitHub class="size-4" />
          )}
        </a>
      )
    }
  </header>

  <p
    class="text-sm leading-relaxed text-neutral-700 dark:text-neutral-300 line-clamp-3"
  >
    {description}
  </p>

  <div
    class="flex flex-wrap gap-2 text-xs text-neutral-700 dark:text-neutral-300"
  >
    {
      tags.map((tag) => (
        <span class="rounded-full border border-neutral-200 px-2.5 py-1 dark:border-neutral-700">
          {tag}
        </span>
      ))
    }
  </div>
</article>
