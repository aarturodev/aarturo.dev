---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';
import GitHub from './icons/GitHub.astro';
import Lock from './icons/Lock.astro';

type Props = {
  project: Project;
};

const { title, description, tags, logo, link, gitHub, visibility } = Astro.props.project;
---

<article
  class="flex flex-col justify-between border border-neutral-300 dark:border-neutral-800 rounded-md overflow-hidden h-full relative dark:bg-neutral-900 shadow-sm hover:shadow-md hover:scale-105 transition-all"
>
  <Image
    src={logo}
    alt={title}
    aria-label={title}
    width={300}
    height={200}
    loading="eager"
    class="w-full h-40 object-cover bg-neutral-200 dark:bg-neutral-700"
  />

  <div class="flex flex-col flex-1 dark:bg-neutral-900">
    <header class="flex items-center justify-between p-4">
      <a
        href={link}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-[6px] font-medium decoration-neutral-500 hover:decoration-neutral-700 dark:decoration-neutral-400"
        aria-label={title}
      >
        <span
          class="text-lg text-neutral-800 dark:text-slate-300 decoration-dotted underline-offset-[7px] hover:underline"
        >
          {title}
        </span>
      </a>

      <a
        href={gitHub}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="hover:opacity-80 transition-opacity"
      >
        {
          visibility === 'private' ? (
            <Lock class="size-4 text-neutral-600 dark:text-neutral-300" />
          ) : (
            <GitHub class="size-4 text-neutral-600 dark:text-neutral-300" />
          )
        }
      </a>
    </header>

    <p class="text-sm px-4 pb-2 text-neutral-700 dark:text-neutral-300 truncate">
      {description}
    </p>

    <footer class="flex flex-wrap items-center p-2 gap-2 overflow-x-clip scroll-custom">
      {
        tags.map((tag) => (
          <span class="inline-flex min-w-max cursor-default items-center space-x-2 rounded-md border border-neutral-300 dark:border-neutral-700 bg-neutral-200/50 dark:bg-neutral-800/60 px-2 py-1 font-mono text-xs font-medium text-neutral-700 dark:text-neutral-300">
            {tag}
          </span>
        ))
      }
    </footer>
  </div>
</article>
