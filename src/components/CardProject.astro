---
import type { Project } from '../data/projects';
import GitHub from './icons/GitHub.astro';
import Lock from './icons/Lock.astro';

type Props = {
  project: Project;
};

const { title, description, tags, logo, link, gitHub, visibility } = Astro.props.project;


---

<article
  class="flex flex-col justify-between border border-neutral-300 rounded-md h-full relative px-3 shadow-sm hover:bg-[#d4d4d432] transition-all hover:shadow dark:border-neutral-800"
>
  <header class="flex items-center justify-between p-2">
    <a
      title={"Ir a " + title}
      href={link}
      target="_blank"
      rel="noopener noreferrer"
      class="group flex items-center gap-[6px] font-medium decoration-neutral-500 hover:cursor-pointer"
    >
      <span>{logo}</span>
      <span
        class="text-lg decoration-dotted underline-offset-[5px] hover:underline dark:text-slate-300"
      >
        {title}
      </span>
      <span
        class="opacity-50 duration-200 group-hover:translate-x-[1.5px] group-hover:opacity-100"
      >
      </span>
    </a>
    <a
      title={visibility === "private"
        ? "Proyecto Privado"
        : "Ver en GitHub"}
      aria-label="GitHub"
      href={gitHub}
      target="_blank"
      rel="noopener noreferrer"
      class="group flex items-center gap-[6px] font-medium decoration-neutral-500 decoration-dotted underline-offset-[5px] hover:cursor-pointer"
    >
      <div class="flex gap-4 items-center">
        {
          visibility === "private" ? (
            <Lock class="size-4 font-bold" />
          ) : (
            <GitHub class="size-4" />
          )
        }
      </div>
    </a>
  </header>

  {/* Descripción */}
  <p class="text-sm p-2 truncate dark:text-neutral-300">
    {description}
  </p>

  {/* Footer (Tags) */}
  <footer class="flex items-center p-2 gap-2 overflow-x-clip scroll-custom">
    {
      tags.map((tag) => (
        <span class="inline-flex min-w-max cursor-default items-center space-x-2 rounded-md border border-neutral-300 bg-neutral-200/50 px-2 py-1 font-mono text-xs font-medium text-neutral-700 dark:border-neutral-800 dark:bg-neutral-800/60 dark:text-neutral-300">
          {tag}
        </span>
      ))
    }
  </footer>
</article>
