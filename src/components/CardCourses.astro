---
import GitHub from './icons/GitHub.astro';
import Lock from './icons/Lock.astro';
import Platzi from './icons/Platzi.astro';

export interface Course {
  title: string;
  logo: string;
  description?: string;
  link?: string;
  gitHub?: string;
  visibility?: string;
  tags?: string[];
}

const {
  title,
  logo,
  description,
  link,
  gitHub,
  visibility,
  tags,
  showDetails = true,
  showImage = true,
} = Astro.props;
---

<article
  class="group flex h-full flex-col gap-4 rounded-2xl bg-white p-4 shadow-[0_15px_50px_-45px_rgba(0,0,0,0.35)] transition duration-300 ease-out hover:-translate-y-[2px] dark:bg-neutral-900"
>
  {showImage && (
    <div
      class="aspect-[16/9] w-full overflow-hidden rounded-xl bg-neutral-900 ring-1 ring-neutral-900 transition duration-300 group-hover:ring-neutral-700"
    >
      <div
        class="flex h-full w-full items-center justify-center text-4xl text-white"
      >
        {
          logo ? (
          <img src={logo} alt={title} class="w-full h-full object-contain grayscale transition duration-200 group-hover:grayscale-0" />
          ) : (
            <Platzi class="size-10" />
          )
        }
      </div>
    </div>
  )}

  {showDetails && (
    <>
      <header class="flex items-start justify-between">
        <div class="space-y-1">
          <a
            href={link}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[18px] font-semibold text-neutral-900 transition group-hover:text-neutral-700 dark:text-neutral-50 dark:group-hover:text-neutral-200"
            aria-label={title}
          >
            {title}
          </a>
          <p
            class="text-[11px] font-medium uppercase tracking-[0.12em] text-neutral-400 dark:text-neutral-500"
          >
            {visibility === 'private' ? 'Privado' : 'Público'}
          </p>
        </div>
        {
          gitHub && (
            <a
              href={gitHub}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitHub"
              title="Repositorio de GitHub"
              class="rounded-md p-2 text-neutral-400 transition hover:bg-neutral-50 hover:text-neutral-900 dark:text-neutral-500 dark:hover:bg-neutral-800 dark:hover:text-neutral-100"
            >
              {visibility === 'private' ? (
                <Lock class="size-4" />
              ) : (
                <GitHub class="size-4" />
              )}
            </a>
          )
        }
      </header>

      <p
        class="text-[15px] leading-relaxed text-neutral-700 line-clamp-3 dark:text-neutral-200"
      >
        {description}
      </p>

      {tags && (
        <div
          class="flex flex-wrap gap-2 text-[11px] text-neutral-500 dark:text-neutral-400"
        >
          {
            tags.map((tag: string) => (
              <span class="rounded-full border border-neutral-200 bg-white px-2.5 py-1 font-semibold tracking-tight transition group-hover:border-neutral-300 group-hover:bg-neutral-50 dark:border-neutral-700 dark:bg-neutral-800 dark:group-hover:border-neutral-600">
                {tag}
              </span>
            ))
          }
        </div>
      )}
    </>
  )}
</article>
