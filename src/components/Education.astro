---
import ExperienceItem from "./ExperienceItem.astro";

const EXPERIENCE = [
  {
    date: "at the moment",
    title: "Systems and Computing Engineering",
    empresa: "University of Cundinamarca",
    link: "https://www.ucundinamarca.edu.co/",
    description:
      "8th semester student, with a focus on software development and project management. I have acquired skills in programming, databases, networks and operating systems, among other fundamental aspects for my professional training.",
  },
  {
    date: "May 2020",
    title: "Software Development Technician",
    empresa: "SENA",
    link: "https://oferta.senasofiaplus.edu.co/sofia-oferta/inicio-sofia-plus.html",
    description:
      "Graduate of the Software Development Technician program, with skills in programming, databases and web development. Experience in optimized and scalable projects, using agile methodologies. Committed to best practices throughout the software life cycle to offer efficient solutions adapted to market demands.",
  },
];
---

<section>
  <h3 class="text-xl py-4 font-medium">Education</h3>
  <ol class="relative border-s border-gray-200 dark:border-gray-700 ml-3">
    {
      EXPERIENCE.map((experience) => (
        <li class="mb-10 m-6">
          <ExperienceItem {...experience} />
        </li>
      ))
    }
  </ol>
</section>
