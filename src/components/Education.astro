---
import LineTime from "./LineTime.astro";
import {EDUCATION} from "../data/education.ts";
---

<section>
  <h3 class="text-xl py-4 font-medium">Educación </h3>
  <ol class="relative border-s border-gray-200 dark:border-gray-700 ml-3">
    {
      EDUCATION.map((education) => (
        <li class="mb-10 m-6">
          <LineTime data={education}/>
        </li>
      ))
    }
  </ol>
</section>
