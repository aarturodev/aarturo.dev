---
import { Image } from 'astro:assets';
---

<section class="bg-neutral-100/80 dark:bg-neutral-900/80 dark:text-neutral-300 py-16">
  <div class="max-w-5xl mx-auto px-6 flex flex-col-reverse md:flex-row items-center gap-12">
    <div class="text-center md:text-left">
      <h1 class="text-4xl md:text-5xl font-extrabold text-neutral-900 dark:text-white mb-6">
        Hola, soy Anderson 🚀
      </h1>

      <p class="text-lg md:text-xl font-light dark:text-neutral-400">
        Soy desarrollador de Bogotá, Colombia, estudiante de Ingeniería de Sistemas y Computación, y
        miembro del programa Expert en Platzi. Me apasiona crear soluciones modernas, optimizadas y
        de alto rendimiento, siempre en busca de nuevos desafíos para crecer profesionalmente.
      </p>
    </div>

    <div class="flex justify-center">
      <div class="w-48 h-48 md:w-60 md:h-60 rounded-full overflow-hidden shadow-lg">
        <Image
          src="https://avatars.githubusercontent.com/u/83318404?s=400&u=774ed4c9633931c24f6f521ec53a52629de29aea&v=4"
          alt="Anderson - Desarrollador Fullstack"
          class="w-full h-full object-cover"
          loading="eager"
          width={300}
          height={300}
          aria-label="Anderson - Desarrollador Fullstack"
          title="Anderson - Desarrollador Fullstack"
        />
      </div>
    </div>
  </div>
</section>
