---
import type { Experience } from '../data/experience';

interface Props {
  data: Experience;
}

const experience = Astro.props.data;
---

<div
  class="absolute w-3 h-3 rounded-full mt-1.5 -start-1.5 border bg-neutral-200 border-neutral-400 dark:border-gray-900 dark:bg-gray-700"
>
</div>
<time class="mb-2 font-mono text-sm font-normal leading-none text-neutral-600 dark:text-neutral-400"
  >{experience.date}
</time>
<div>
  <h3
    class="text-lg font-semibold tracking-tight text-gray-900 dark:text-white group-hover:text-gray-900 dark:group-hover:text-white"
  >
    {experience.title}
  </h3>
  <p
    title={'Empresa ' + experience.empresa}
    aria-label={'Empresa ' + experience.empresa}
    class="group flex w-max items-center text-pretty text-sm text-neutral-600 transition-colors duration-150 hover:text-black dark:border-neutral-800 dark:text-neutral-400 dark:hover:text-white"
  >
    {experience.empresa}
    <p class="mt-3 text-pretty text-sm prose dark:prose-invert dark:text-neutral-300">
      {experience.description}
    </p>
  </p>
</div>
