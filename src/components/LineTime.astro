---
const item = Astro.props.data;
---

<article class="relative overflow-hidden rounded-xl border border-neutral-200 bg-white p-4 dark:border-neutral-800 dark:bg-neutral-900">
  <span class="absolute -left-4 top-5 h-3 w-3 rounded-full border-2 border-white bg-neutral-900 shadow dark:border-neutral-900 dark:bg-white"></span>
  <div class="flex items-start justify-between gap-3">
    <div class="space-y-1">
      <h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-50">{item.title}</h3>
      <a
        href={item.link}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm font-semibold text-neutral-700 underline-offset-4 transition hover:text-neutral-900 hover:underline dark:text-neutral-200 dark:hover:text-white"
      >
        {item.empresa}
        <span aria-hidden="true" class="text-base">↗</span>
      </a>
    </div>
    <time class="rounded-full bg-neutral-100 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-neutral-700 ring-1 ring-neutral-200 dark:bg-neutral-800 dark:text-neutral-200 dark:ring-neutral-700">
      {item.date}
    </time>
  </div>
  <p class="mt-3 text-sm leading-relaxed text-neutral-700 dark:text-neutral-300">
    {item.description}
  </p>
</article>
