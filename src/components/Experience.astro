---
import ExperienceItem from "./ExperienceItem.astro";

export const EXPERIENCE = [
  {
    date: "at the moment",
    title: "Full Stack Developer",
    empresa: "Movilidad Bogotá",
    link: "https://www.movilidadbogota.gov.co/web/",
    description:
      "I developed a web application for Movilidad Bogotá that optimizes case management by creating and continuously updating them. I used Angular to build an intuitive user interface and Node.js for the backend, ensuring fluid communication between the two. I implemented token-based authentication and role-based access control to ensure data security and confidentiality. In addition, I designed a secure login system and enabled the generation and download of detailed reports for each case, thus facilitating the monitoring and analysis of information.",
  },
  {
    date: "February 2024",
    title: "Full Stack Developer",
    empresa: "Foscan",
    link: "https://foscan.com/",
    description:
      "I developed a comprehensive web application for Foscan, a company in the oil sector, managing both the front-end and the back-end. I used Angular to create an intuitive and dynamic user interface, while using Node.js I implemented the server logic. I specialized in data visualization through interactive bar and line charts, facilitating the analysis of key information for the company. In addition, I integrated a SQL Server database into Azure through a custom API. This experience allowed me to strengthen my technical skills, providing innovative solutions that directly contributed to Foscan's success.",
  },
];
---

<section>
  <h3 class="text-xl py-4 font-medium">Experience</h3>
  <ol class="relative border-s border-gray-200 dark:border-gray-700 ml-3">
    {
      EXPERIENCE.map((experience) => (
        <li class="mb-10 m-6">
          <ExperienceItem {...experience} />
        </li>
      ))
    }
  </ol>
</section>
