---
import { EXPERIENCE} from "../data/experience.ts";
import type { Experience } from "../data/experience.ts";
import LineTime from "./LineTime.astro";
---

<section>
  <h3 class="text-xl py-4 font-medium">Experiencia</h3>
  <ol class="relative border-s border-gray-200 dark:border-gray-700 ml-3">
    {
      EXPERIENCE.map((experience: Experience) => (
        <li class="mb-10 m-6">
          <LineTime 
            data={experience}
  
           />
        </li>
      ))
    }
  </ol>
</section>
