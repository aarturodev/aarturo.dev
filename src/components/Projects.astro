---
import CardProject from "./CardProject.astro";
import Arrow from "./icons/Arrow.astro";
import {PROJECTS, type Project} from "../data/projects";
---

<section>
  <div class="flex justify-between py-4">
    <h3 class="text-xl p-2 font-medium">Proyectos</h3>
    <a
      title="Más proyectos"
      aria-label="More projects"
      class="flex items-center gap-1 -translate-x-3 hover:scale-105 ease-in-out duration-300 text-neutral-500"
      href="/projects"
    >
      <span class="text-sm"></span>
      <Arrow class="size-5 rotate-45"/>
    </a>
    <!-- -->
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    {
      PROJECTS.slice(0, 4).map((project : Project) => (
       <CardProject project={project} />
      ))
    }
  </div>
</section>
