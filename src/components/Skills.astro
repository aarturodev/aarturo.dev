---
import { SKILL_CATEGORIES } from '../data/skills';
---

<section
  id="habilidades"
  class="w-full flex justify-center items-center px-4 min-h-screen snap-start"
>
  <div
    class="mx-auto flex w-full max-w-5xl flex-col gap-6 rounded-2xl px-4 py-6"
  >
    <div class="pb-3">
      <p
        class="text-xs font-semibold uppercase tracking-[0.18em] text-neutral-400"
      >
        Stack
      </p>
      <h3 class="text-4xl font-semibold tracking-tight text-neutral-900">
        Habilidades principales
      </h3>
    </div>

    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-2">
      {
        SKILL_CATEGORIES.map(({ label, items }) => (
          <div class="space-y-3">
            <p class="text-sm font-semibold uppercase tracking-[0.14em] text-neutral-500">
              {label}
            </p>
            <div class="grid grid-cols-2 gap-2 text-sm text-neutral-700 sm:grid-cols-3 dark:text-neutral-200">
              {items.slice(0, 6).map((item) => (
                <div class="group flex items-center gap-2 rounded-xl bg-neutral-100/80 px-2 py-2 ring-1 ring-neutral-200/70 transition duration-200 hover:ring-neutral-300 dark:bg-neutral-800/70 dark:ring-neutral-700/60 dark:hover:ring-neutral-600">
                  {item.icon && (
                    <div class="flex h-6 w-6 items-center justify-center">
                      <item.icon class="h-6 w-6 text-neutral-600 transition duration-200 filter grayscale group-hover:grayscale-0 group-hover:text-neutral-900 dark:text-neutral-200 dark:group-hover:text-neutral-50" />
                    </div>
                  )}
                  <span class="text-neutral-800 dark:text-neutral-50">
                    {item.name}
                  </span>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
